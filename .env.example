# Vimero Agent — konfigurasi LLM gateway (OpenAI-compatible)
# adaCODE: https://api.adacode.ai  |  OpenRouter: https://openrouter.ai/api/v1
VIMERO_API_BASE=https://api.adacode.ai/v1
VIMERO_API_KEY=sk-ganti-dengan-api-key-kamu
VIMERO_DEFAULT_MODEL=claude-sonnet-4-6
# Daftar model yang muncul di dropdown terminal (pisahkan dengan koma)
VIMERO_MODELS=claude-sonnet-4-6,claude-opus-4-6,qwen3.5-plus,gpt-5.3,GLM-4.7,MiniMax-M2.5
# Port server
VIMERO_PORT=8021
